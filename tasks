cd "$( dirname -- "${"${(%):-%N}"#"./"}")"
if [[ "$1" == "-i" ]] ; then
  eval "$(grep "^ *# *-> *" "${"${(%):-%N}"##*/}" | fzf | sed -e 's/^# *-> *//g' )"
elif (( $# > 0 )) ; then
  for index in "$@" ; do
    cmd="$(grep "^ *# *-> *" "${"${(%):-%N}"##*/}" | head -n "$index" | tail -n1 | sed -e 's/^# *-> *//g')"
    echo "$cmd"
    eval "$cmd"
  done
else
  grep "^ *# *-> *" "${"${(%):-%N}"##*/}" | sed -e 's/^# *-> *//g' | awk 'BEGIN{ count = 0 }{ count = count + 1 ; print count ":" $0 }'
fi
